#!/usr/bin/env python3
"""
ELK-BLEDDM LED Backlight Controller
Usage:
  led on                  Turn lights on
  led off                 Turn lights off
  led color RRGGBB        Set color (hex, e.g. FF0000 for red)
  led color NAME          Set color by name (red, green, blue, ...)
  led preset NAME         Apply a named preset (e.g. relax, focus, movie)
  led presets             List available presets
  led brightness N        Set brightness (0-100)
  led white N             Set white/warmth (0-100)
  led mode N              Set built-in mode (0-??)
  led mode NAME           Set built-in effect by name (e.g. rainbow, fade)
  led effects             List available effects
  led speed N             Set mode speed (0-100)
  led status              Query current status
"""
import sys
import time
import json
import os
import dbus

from elkbleddm_common import (
    bus,
    BUS_NAME,
    DEV_MAC,
    DEV_PATH,
    NOTIFY_CHAR_PATH,
    SETTLE,
    ensure_connected,
    send,
    disconnect,
    resolve_effect,
    EFFECTS,
    EFFECT_ALIASES,
)

# SSG1068 firmware uses 0x07 variant byte (NOT 0x04/0x00 like standard ELK-BLEDDM)
# WARNING: 7E 00 05 and 7E 00 06 commands FREEZE this controller!

NAMED_COLORS = {
    "red": "FF0000",
    "green": "00FF00",
    "blue": "0000FF",
    "white": "FFFFFF",
    "black": "000000",
    "off": "000000",
    "yellow": "FFFF00",
    "cyan": "00FFFF",
    "magenta": "FF00FF",
    "purple": "800080",
    "orange": "FF8800",
    "pink": "FF69B4",
    "teal": "008080",
    "warmwhite": "FFE8CC",
    "coolwhite": "E6F0FF",
}

PRESET_FILE = os.path.expanduser("~/.config/elkbleddm/presets.json")

DEFAULT_PRESETS = {
    "relax": {"color": "FF7800", "brightness": 60},
    "focus": {"color": "FFFFFF", "brightness": 90},
    "movie": {"color": "640096", "brightness": 35},
    "night": {"color": "FF3C00", "brightness": 15},
    "party": {"color": "FF00FF", "brightness": 100},
}


def _load_presets():
    """Load presets from disk, merged over defaults."""
    presets = dict(DEFAULT_PRESETS)
    try:
        with open(PRESET_FILE) as f:
            user = json.load(f)
        if isinstance(user, dict):
            presets.update(user)
    except FileNotFoundError:
        pass
    except (OSError, json.JSONDecodeError) as e:
        print(f"Warning: could not read {PRESET_FILE}: {e}", file=sys.stderr)
    return presets


def _resolve_hex(color):
    """Resolve a color argument (hex or name) to an uppercase 6-digit hex string."""
    color = color.strip().lstrip("#")
    if color.lower() in NAMED_COLORS:
        return NAMED_COLORS[color.lower()]
    if len(color) == 6:
        try:
            int(color, 16)
            return color.upper()
        except ValueError:
            pass
    raise ValueError(f"invalid color: {color!r}")


def cmd_on():
    ensure_connected()
    send(bytes([0x7E, 0x07, 0x04, 0x01, 0x00, 0xFF, 0xFF, 0x00, 0xEF]))
    time.sleep(SETTLE)
    print("ON")


def cmd_off():
    """Turn off via SSG power-off command, fall back to disconnect."""
    ensure_connected()
    # SSG1068 power OFF: 7E 07 04 00 00 00 02 01 EF
    send(bytes([0x7E, 0x07, 0x04, 0x00, 0x00, 0x00, 0x02, 0x01, 0xEF]))
    time.sleep(SETTLE)
    # Also disconnect as fallback
    disconnect()
    print("OFF")


def cmd_color(color):
    ensure_connected()
    hex_color = _resolve_hex(color)
    r = int(hex_color[0:2], 16)
    g = int(hex_color[2:4], 16)
    b = int(hex_color[4:6], 16)
    send(bytes([0x7E, 0x07, 0x05, 0x03, r, g, b, 0x10, 0xEF]))
    time.sleep(SETTLE)
    print(f"Color: #{hex_color}")


def cmd_brightness(val):
    ensure_connected()
    v = max(0, min(100, int(val)))
    send(bytes([0x7E, 0x07, 0x01, v, 0xFF, 0xFF, 0xFF, 0x00, 0xEF]))
    time.sleep(SETTLE)
    print(f"Brightness: {v}%")


def cmd_white(val):
    ensure_connected()
    v = max(0, min(100, int(val)))
    send(bytes([0x7E, 0x07, 0x01, v, 0xFF, 0xFF, 0xFF, 0x00, 0xEF]))
    time.sleep(SETTLE)
    print(f"White: {v}%")


def cmd_mode(val):
    ensure_connected()
    v = resolve_effect(val)
    send(bytes([0x7E, 0x07, 0x03, v, 0xFF, 0xFF, 0xFF, 0x00, 0xEF]))
    time.sleep(SETTLE)
    print(f"Mode: {v}")


def cmd_effects():
    """List available firmware effects."""
    for name in sorted(EFFECTS):
        print(f"{name:24s} {EFFECTS[name]}")
    print()
    print("Aliases:", ", ".join(sorted(EFFECT_ALIASES)))


def cmd_speed(val):
    ensure_connected()
    v = max(0, min(100, int(val)))
    send(bytes([0x7E, 0x07, 0x02, v, 0xFF, 0xFF, 0xFF, 0x00, 0xEF]))
    time.sleep(SETTLE)
    print(f"Speed: {v}%")


def cmd_status():
    """Read device identity and connection state.

    The SSG1068 firmware exposes only a firmware ID string on the notify
    characteristic (fff4); there is no state read-back for color/brightness.
    """
    ensure_connected()
    dev = bus.get_object(BUS_NAME, DEV_PATH)
    dev_props = dbus.Interface(dev, "org.freedesktop.DBus.Properties")
    try:
        connected = bool(dev_props.Get("org.bluez.Device1", "Connected"))
    except dbus.exceptions.DBusException:
        connected = False
    print(f"Device:    {DEV_MAC}")
    print(f"Connected: {connected}")
    try:
        char = bus.get_object(BUS_NAME, NOTIFY_CHAR_PATH)
        char_iface = dbus.Interface(char, "org.bluez.GattCharacteristic1")
        raw = char_iface.ReadValue(dbus.Dictionary({}, signature='sv'))
        data = bytes(b for b in raw)
        # Firmware ID is a null-padded ASCII string; strip trailing NULs.
        fw = data.split(b"\x00")[0].decode("ascii", errors="replace")
        print(f"Firmware:  {fw}")
    except dbus.exceptions.DBusException as e:
        print(f"Firmware:  (unavailable: {e})")
    # Send a query to elicit any live response (notifications are not read here;
    # this firmware returns only the firmware ID, not color/brightness state).
    send(bytes([0x7E, 0x07, 0x01, 0xFA, 0xFF, 0xFF, 0xFF, 0x00, 0xEF]))
    time.sleep(SETTLE)


def cmd_presets():
    """List available presets."""
    presets = _load_presets()
    for name in sorted(presets):
        p = presets[name]
        print(f"{name:12s} #{p.get('color', '??????').upper()}  brightness {p.get('brightness', '-')}")


def cmd_preset(name):
    """Apply a named preset: color + optional brightness."""
    presets = _load_presets()
    if name not in presets:
        print(f"Unknown preset: {name!r}. Available: {', '.join(sorted(presets))}")
        sys.exit(1)
    p = presets[name]
    cmd_color(p.get("color", "FFFFFF"))
    if "brightness" in p:
        cmd_brightness(p["brightness"])


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)

    cmd = sys.argv[1].lower()

    if cmd == "on":
        cmd_on()
    elif cmd == "off":
        cmd_off()
    elif cmd == "color" and len(sys.argv) > 2:
        try:
            cmd_color(sys.argv[2])
        except ValueError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)
    elif cmd == "preset" and len(sys.argv) > 2:
        cmd_preset(sys.argv[2])
    elif cmd == "presets":
        cmd_presets()
    elif cmd == "brightness" and len(sys.argv) > 2:
        cmd_brightness(sys.argv[2])
    elif cmd == "white" and len(sys.argv) > 2:
        cmd_white(sys.argv[2])
    elif cmd == "mode" and len(sys.argv) > 2:
        try:
            cmd_mode(sys.argv[2])
        except ValueError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)
    elif cmd == "effects":
        cmd_effects()
    elif cmd == "speed" and len(sys.argv) > 2:
        cmd_speed(sys.argv[2])
    elif cmd == "status":
        cmd_status()
    else:
        print(__doc__)
        sys.exit(1)
