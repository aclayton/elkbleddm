#!/usr/bin/env python3
"""Music-reactive color mode for the ELK-BLEDDM LED strip.

Two algorithms combined:
  1. Three-band spectral analysis -> RGB mixing
     Bass (20-250 Hz) -> Red, Mid (250-2000 Hz) -> Green, Treble (2k-8k Hz) -> Blue
  2. Beat-triggered brightness pulses
     RMS spike detection with EMA baseline, cooldown, and exponential decay

The 350 ms BLE settle time (~3 updates/sec) is well-matched to beat detection
at typical music tempos (60-180 BPM = 1-3 beats/sec).

Captures audio from the system microphone with `arecord` (ALSA).

Usage:
  led-music                     React to the default microphone
  led-music --device plughw:0,0 Capture from a specific ALSA device
  led-music --rate 48000        Use a 48 kHz sample rate (default 16000)
  led-music --gain 2.0          Overall sensitivity multiplier (default 2.0)
  led-music --beat-threshold 1.4  Beat detection trigger (default 1.4)

Ctrl+C to stop.
"""

import sys
import time
import math
import argparse
import subprocess
import numpy as np

from elkbleddm_common import SETTLE, ensure_connected, send, disconnect

# Frequency-cutoff bins (Hz).
BASS_LO, BASS_HI = 20, 250
MID_LO, MID_HI = 250, 2000
TREBLE_LO, TREBLE_HI = 2000, 8000

# Per-band pre-emphasis gains to balance the visual mix.
# Energy is already normalised per Hz of bandwidth, so white noise
# produces roughly flat output. A mild mid boost lifts vocals/melody;
# treble is kept at 1.0 so ambient hiss doesn't blue-tint the idle glow.
# Tweak these live with --gain to taste.
BAND_GAIN = {"bass": 1.0, "mid": 1.6, "treble": 1.0}

# Beat detection constants.
RMS_EMA_ALPHA = 0.15  # how fast the baseline adapts (0-1, lower = slower)
BEAT_BOOST = 1.9      # brightness multiplier on beat
BEAT_DECAY = 0.55     # per-tick decay factor toward 1.0
BEAT_COOLDOWN_TICKS = 1  # ticks to suppress after a beat (avoids double-fires)

# Color smoothing: EMA alpha for RGB output.
COLOR_SMOOTH = 0.35

# Silence floor for RMS (below this, beat detection is disabled).
RMS_SILENCE_FLOOR = 40.0


def bin_idx(freq_hz, n_samples, rate):
    """Closest rfft bin index for a given frequency."""
    idx = int(freq_hz * n_samples / rate)
    return max(0, min(idx, n_samples // 2))


def band_energies(spectrum, n_samples, rate):
    """Return (bass, mid, treble) mean spectral energy per Hz in each band.

    Normalising by bandwidth means white noise produces roughly equal values
    across bands regardless of band width, so the relative pre-emphasis gains
    actually control the colour balance rather than bandwidth differences.
    """
    b_lo = bin_idx(BASS_LO, n_samples, rate)
    b_hi = bin_idx(BASS_HI, n_samples, rate)
    m_lo = bin_idx(MID_LO, n_samples, rate)
    m_hi = bin_idx(MID_HI, n_samples, rate)
    t_lo = bin_idx(TREBLE_LO, n_samples, rate)
    t_hi = bin_idx(TREBLE_HI, n_samples, rate)

    bw_bass = max(1, BASS_HI - BASS_LO)
    bw_mid = max(1, MID_HI - MID_LO)
    bw_treble = max(1, TREBLE_HI - TREBLE_LO)

    bass = np.sum(spectrum[b_lo:b_hi] ** 2) / bw_bass * BAND_GAIN["bass"]
    mid = np.sum(spectrum[m_lo:m_hi] ** 2) / bw_mid * BAND_GAIN["mid"]
    treble = np.sum(spectrum[t_lo:t_hi] ** 2) / bw_treble * BAND_GAIN["treble"]
    return bass, mid, treble


def start_capture(device, rate):
    """Spawn arecord and return its stdout pipe."""
    cmd = ["arecord", "-D", device, "-f", "S16_LE", "-r", str(rate),
           "-c", "1", "-t", "raw"]
    return subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)


def react(device, rate, gain=2.0, beat_threshold=1.4):
    ensure_connected()
    # Power on the strip (the script assumes the strip is on, but it may not be).
    send(bytes([0x7E, 0x07, 0x04, 0x01, 0x00, 0xFF, 0xFF, 0x00, 0xEF]))
    time.sleep(SETTLE)

    proc = start_capture(device, rate)

    samples_per_tick = int(rate * SETTLE)
    bytes_per_tick = samples_per_tick * 2  # 16-bit mono
    buf = b""

    # Running state.
    rms_ema = None          # exponential moving average of RMS
    beat_cooldown = 0       # ticks remaining in cooldown
    beat_boost = 1.0        # current brightness multiplier
    r_smooth = g_smooth = b_smooth = 0.0  # smoothed color

    print(f"Music mode on!  rate={rate} Hz, 3-band RGB + beat detection.  "
          f"Ctrl+C to stop.", flush=True)

    try:
        while True:
            # Fill buffer to one tick worth of samples.
            while len(buf) < bytes_per_tick:
                chunk = proc.stdout.read(bytes_per_tick - len(buf))
                if not chunk:
                    raise RuntimeError("audio stream ended")
                buf += chunk

            tick = buf[:bytes_per_tick]
            buf = buf[bytes_per_tick:]

            samples = np.frombuffer(tick, dtype=np.int16).astype(np.float64)
            n_samples = len(samples)

            # ---- FFT for three-band energies ----
            window = samples * np.hanning(n_samples)
            spectrum = np.abs(np.fft.rfft(window))
            bass, mid, treble = band_energies(spectrum, n_samples, rate)

            # Map band energies to R, G, B via normalized proportion.
            # Large floor in denominator prevents division-by-zero in silence.
            total = bass + mid + treble + 1e8
            # If there's meaningful audio, use the spectral mix. In silence, fall
            # back to a warm dim glow so the strip never goes fully dark.
            sig = bass + mid + treble
            if sig < 1e8:
                r_raw, g_raw, b_raw = 40, 25, 15  # warm dim idle glow
            else:
                r_raw = min(255, int(255 * bass / total * gain))
                g_raw = min(255, int(255 * mid / total * gain))
                b_raw = min(255, int(255 * treble / total * gain))

            # ---- Beat detection ----
            rms = math.sqrt(np.mean(samples ** 2))
            if rms_ema is None:
                rms_ema = rms
            else:
                rms_ema = (1.0 - RMS_EMA_ALPHA) * rms_ema + RMS_EMA_ALPHA * rms

            if beat_cooldown > 0:
                beat_cooldown -= 1
                # Bump the EMA during cooldown so it catches up and avoids re-triggering
                # inside sustained loud passages.
                rms_ema = (1.0 - RMS_EMA_ALPHA * 3) * rms_ema + RMS_EMA_ALPHA * 3 * rms
            elif rms > beat_threshold * rms_ema and rms_ema > RMS_SILENCE_FLOOR:
                beat_cooldown = BEAT_COOLDOWN_TICKS
                beat_boost = BEAT_BOOST
                # Jump the EMA immediately so this onset only fires once.
                rms_ema = rms * 0.85
            else:
                # Exponential decay toward 1.0.
                beat_boost = BEAT_DECAY * beat_boost + (1.0 - BEAT_DECAY) * 1.0

            # ---- Combine base color with beat boost ----
            r_out = min(255, int(r_raw * beat_boost))
            g_out = min(255, int(g_raw * beat_boost))
            b_out = min(255, int(b_raw * beat_boost))

            # ---- Smooth color transitions ----
            r_smooth = COLOR_SMOOTH * r_out + (1.0 - COLOR_SMOOTH) * r_smooth
            g_smooth = COLOR_SMOOTH * g_out + (1.0 - COLOR_SMOOTH) * g_smooth
            b_smooth = COLOR_SMOOTH * b_out + (1.0 - COLOR_SMOOTH) * b_smooth

            send(bytes([0x7E, 0x07, 0x05, 0x03,
                        int(r_smooth), int(g_smooth), int(b_smooth),
                        0x10, 0xEF]))
            time.sleep(SETTLE)

    except KeyboardInterrupt:
        print("\nStopped.", flush=True)
    except RuntimeError as e:
        print(f"\nError: {e}", flush=True)
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()
        # Leave the strip on a warm low glow rather than going dark.
        send(bytes([0x7E, 0x07, 0x05, 0x03, 50, 30, 10, 0x10, 0xEF]))
        time.sleep(SETTLE)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Music-reactive 3-band RGB + beat detection for LED strip")
    parser.add_argument("--device", default="plughw:0,7", help="ALSA capture device")
    parser.add_argument("--rate", type=int, default=16000, help="sample rate (Hz)")
    parser.add_argument("--gain", type=float, default=2.0,
                        help="sensitivity multiplier (default 2.0)")
    parser.add_argument("--beat-threshold", type=float, default=1.4,
                        help="RMS multiplier to trigger a beat (default 1.4)")
    args = parser.parse_args()
    react(args.device, args.rate, args.gain, args.beat_threshold)
