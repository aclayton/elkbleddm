#!/usr/bin/env python3
"""Music-reactive color mode for the ELK-BLEDDM LED strip.

Two algorithms combined:
  1. Three-band spectral analysis -> RGB mixing
     Bass (20-250 Hz) -> Red, Mid (250-2000 Hz) -> Green, Treble (2k-8k Hz) -> Blue
  2. Beat-triggered brightness pulses
     RMS spike detection with EMA baseline, cooldown, and exponential decay

Audio is captured continuously in a background thread so no samples are
discarded during BLE writes. Each tick reads the freshest ~128 ms window
from the ring buffer regardless of when the last BLE write finished.

Usage:
  led-music                     React to the digital mic array
  led-music --device plughw:0,0 Capture from a specific ALSA device
  led-music --rate 48000        Use a 48 kHz sample rate (default 16000)
  led-music --gain 2.0          Overall sensitivity multiplier (default 2.0)
  led-music --beat-threshold 1.4  Beat detection trigger (default 1.4)

Ctrl+C to stop.
"""

import sys
import time
import math
import argparse
import subprocess
import threading
import numpy as np

from elkbleddm_common import SETTLE, ensure_connected, send

# Frequency-cutoff bins (Hz).
BASS_LO, BASS_HI = 20, 250
MID_LO, MID_HI = 250, 2000
TREBLE_LO, TREBLE_HI = 2000, 8000

# Per-band pre-emphasis gains.
BAND_GAIN = {"bass": 1.0, "mid": 1.6, "treble": 1.0}

# Beat detection constants.
RMS_EMA_ALPHA = 0.15
BEAT_BOOST = 1.9
BEAT_DECAY = 0.55
BEAT_COOLDOWN_TICKS = 1

# Color smoothing.
COLOR_SMOOTH = 0.35

# Silence floor.
RMS_SILENCE_FLOOR = 40.0

# FFT window: 128 ms of audio at 16 kHz.
FFT_SIZE = 2048


def bin_idx(freq_hz, n_samples, rate):
    idx = int(freq_hz * n_samples / rate)
    return max(0, min(idx, n_samples // 2))


def band_energies(spectrum, n_samples, rate):
    b_lo = bin_idx(BASS_LO, n_samples, rate)
    b_hi = bin_idx(BASS_HI, n_samples, rate)
    m_lo = bin_idx(MID_LO, n_samples, rate)
    m_hi = bin_idx(MID_HI, n_samples, rate)
    t_lo = bin_idx(TREBLE_LO, n_samples, rate)
    t_hi = bin_idx(TREBLE_HI, n_samples, rate)

    bw_b = max(1, BASS_HI - BASS_LO)
    bw_m = max(1, MID_HI - MID_LO)
    bw_t = max(1, TREBLE_HI - TREBLE_LO)

    bass = np.sum(spectrum[b_lo:b_hi] ** 2) / bw_b * BAND_GAIN["bass"]
    mid = np.sum(spectrum[m_lo:m_hi] ** 2) / bw_m * BAND_GAIN["mid"]
    treble = np.sum(spectrum[t_lo:t_hi] ** 2) / bw_t * BAND_GAIN["treble"]
    return bass, mid, treble


def send_safe(data):
    """Send with automatic reconnect on BLE errors."""
    try:
        send(data)
    except Exception:
        try:
            ensure_connected()
            time.sleep(SETTLE)
            send(data)
        except Exception:
            pass


def reader_thread(proc, ring, ring_lock, stop_event):
    """Background thread: pump audio into a ring buffer continuously."""
    while not stop_event.is_set():
        chunk = proc.stdout.read(4096)
        if not chunk:
            break
        with ring_lock:
            ring.extend(chunk)
            # Keep ~1 sec of audio (32 KiB at 16 kHz mono 16-bit).
            if len(ring) > 64000:
                del ring[:32000]


def react(device, rate, gain=2.0, beat_threshold=1.4):
    ensure_connected()
    send_safe(bytes([0x7E, 0x07, 0x04, 0x01, 0x00, 0xFF, 0xFF, 0x00, 0xEF]))
    time.sleep(SETTLE)

    proc = subprocess.Popen(
        ["arecord", "-D", device, "-f", "S16_LE", "-r", str(rate),
         "-c", "1", "-t", "raw"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)

    ring = bytearray()
    ring_lock = threading.Lock()
    stop_event = threading.Event()
    reader = threading.Thread(target=reader_thread,
                              args=(proc, ring, ring_lock, stop_event),
                              daemon=True)
    reader.start()

    # Warm up: wait for enough audio.
    while len(ring) < FFT_SIZE * 2:
        time.sleep(0.05)

    # Running state.
    rms_ema = None
    beat_cooldown = 0
    beat_boost = 1.0
    r_smooth = g_smooth = b_smooth = 0.0

    print(f"Music mode on!  rate={rate} Hz, 3-band RGB + beat detection.  "
          f"Ctrl+C to stop.", flush=True)

    # Last-sent colour: only push to BLE when the value actually changes.
    last_r = last_g = last_b = -1
    last_send = 0.0  # epoch of last BLE write

    try:
        while True:
            # Pull exactly FFT_SIZE samples from the ring buffer.
            with ring_lock:
                total = len(ring)
            if total < FFT_SIZE * 2:
                time.sleep(0.01)
                continue
            with ring_lock:
                raw = bytes(ring[total - FFT_SIZE * 2:total])

            samples = np.frombuffer(raw, dtype=np.int16).astype(np.float64)

            # ---- FFT for three-band energies ----
            window = samples * np.hanning(FFT_SIZE)
            spectrum = np.abs(np.fft.rfft(window))
            bass, mid, treble = band_energies(spectrum, FFT_SIZE, rate)

            total = bass + mid + treble + 1e8
            sig = bass + mid + treble
            if sig < 1e8:
                r_raw, g_raw, b_raw = 40, 25, 15
            else:
                r_raw = min(255, int(255 * bass / total * gain))
                g_raw = min(255, int(255 * mid / total * gain))
                b_raw = min(255, int(255 * treble / total * gain))

            # ---- Beat detection ----
            rms = math.sqrt(np.mean(samples ** 2))
            if rms_ema is None:
                rms_ema = rms
            else:
                rms_ema = (1.0 - RMS_EMA_ALPHA) * rms_ema + RMS_EMA_ALPHA * rms

            if beat_cooldown > 0:
                beat_cooldown -= 1
                rms_ema = (1.0 - RMS_EMA_ALPHA * 3) * rms_ema + RMS_EMA_ALPHA * 3 * rms
            elif rms > beat_threshold * rms_ema and rms_ema > RMS_SILENCE_FLOOR:
                beat_cooldown = BEAT_COOLDOWN_TICKS
                beat_boost = BEAT_BOOST
                rms_ema = rms * 0.85
            else:
                beat_boost = BEAT_DECAY * beat_boost + (1.0 - BEAT_DECAY) * 1.0

            # ---- Combine & smooth ----
            r_out = min(255, int(r_raw * beat_boost))
            g_out = min(255, int(g_raw * beat_boost))
            b_out = min(255, int(b_raw * beat_boost))

            r_smooth = COLOR_SMOOTH * r_out + (1.0 - COLOR_SMOOTH) * r_smooth
            g_smooth = COLOR_SMOOTH * g_out + (1.0 - COLOR_SMOOTH) * g_smooth
            b_smooth = COLOR_SMOOTH * b_out + (1.0 - COLOR_SMOOTH) * b_smooth

            r_i, g_i, b_i = int(r_smooth), int(g_smooth), int(b_smooth)
            now = time.time()

            # Send to BLE only when the colour changed meaningfully (≥4 steps
            # in any channel) or it's been >350 ms since the last send.
            delta = max(abs(r_i - last_r), abs(g_i - last_g), abs(b_i - last_b))
            stale = now - last_send > SETTLE * 1.05
            if delta >= 4 or stale:
                send_safe(bytes([0x7E, 0x07, 0x05, 0x03,
                            r_i, g_i, b_i, 0x10, 0xEF]))
                last_r, last_g, last_b = r_i, g_i, b_i
                last_send = now

            # Tight sleep: analyse at ~20 Hz regardless of BLE rate.
            time.sleep(0.05)

    except KeyboardInterrupt:
        print("\nStopped.", flush=True)
    finally:
        stop_event.set()
        reader.join(timeout=2)
        proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()
        send_safe(bytes([0x7E, 0x07, 0x05, 0x03, 50, 30, 10, 0x10, 0xEF]))
        time.sleep(SETTLE)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Music-reactive 3-band RGB + beat detection for LED strip")
    parser.add_argument("--device", default="plughw:0,7",
                        help="ALSA capture device")
    parser.add_argument("--rate", type=int, default=16000,
                        help="sample rate (Hz)")
    parser.add_argument("--gain", type=float, default=2.0,
                        help="sensitivity multiplier")
    parser.add_argument("--beat-threshold", type=float, default=1.4,
                        help="RMS multiplier to trigger a beat")
    args = parser.parse_args()
    react(args.device, args.rate, args.gain, args.beat_threshold)
